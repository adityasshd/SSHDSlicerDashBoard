# Recovery example for this app served at / with its application directory
# also configured as the domain document root in cPanel.
# Copy to /home/ipsutpvq3gsk/dashboard_app/.htaccess only after confirming
# the PassengerPython executable below exists in your cPanel virtual environment.
# Use the configuration generated by Setup Python App when available.
# Preserve existing cPanel environment-variable blocks and unrelated rules.

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerEnabled on
PassengerAppRoot "/home/ipsutpvq3gsk/dashboard_app"
PassengerBaseURI "/"
PassengerPython "/home/ipsutpvq3gsk/virtualenv/dashboard_app/3.11/bin/python"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerAppEnv production
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# The document root contains private application files. Keep those files out
# of direct HTTP responses while allowing /.well-known/ for domain validation.
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:config|data|logs|src|tests|scripts|docs|server)(?:/|$) - [F,L]

<FilesMatch "(?i)\.(?:py|pyc|pyo|toml|ya?ml|lock|md)$|^requirements\.txt$|^package(?:-lock)?\.json$">
    Require all denied
</FilesMatch>
