# Dashboard credentials - NEVER commit actual values
DASHBOARD_URL=http://120.79.192.226/
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel is always a saved-data viewer. Set this for the same behavior locally.
# Collectors run outside Vercel with DASHBOARD_ROLE=collector (or unset).
DASHBOARD_ROLE=

# Timezone for date normalization
TIMEZONE=Asia/Kolkata
EFFICIENCY_LEADER_ID=803

# Report/API read concurrency: 1 disables additional report worker threads.
DASHBOARD_MAX_WORKERS=2

# Shared durable storage is required for scheduled captures on Vercel.
MONGO_URI=

# Random secret for /api/data-refresh, /api/data-health, /api/storage-health and worker endpoints. Set the same value
# in Vercel and the scheduler's Authorization: Bearer header; never put it in a URL.
CRON_SECRET=
